# ── dev 스테이지 (AWS RDS — SSH 터널 경유) ─────────────────────────────
# 복사: cp .env.dev.example .env.dev  → 값 채우기
# 사용: 터미널 1 `pnpm tunnel:dev:rds` → 터미널 2 `pnpm db:dev:push` / `pnpm seed:dev`
IS_LOCAL=true
AWS_PROFILE=weekly-report-dev
AWS_REGION=ap-northeast-2

# `pnpm deploy:dev:rds` Outputs 의 RdsSecretName / RdsEndpoint
RDS_SECRET_ARN=weekly-report-dev/rds-credentials
RDS_ENDPOINT=weekly-report-dev-postgres.xxxxxxxxxxxx.ap-northeast-2.rds.amazonaws.com
RDS_DB_NAME=weekly_report
RDS_LOCAL_PORT=15442

# 로컬에서 dev DB 로 서버를 띄울 때만 필요 (Lambda 는 Secrets Manager 의 값을 사용)
JWT_SECRET=local-dev-jwt-secret-change-me
