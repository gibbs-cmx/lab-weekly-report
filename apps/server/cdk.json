{
  "app": "npx ts-node --prefer-ts-exts --project tsconfig.cdk.json bin/cdk.ts",
  "watch": {
    "include": ["bin/**", "lib/**"],
    "exclude": ["README.md", "cdk*.json", "**/*.d.ts", "**/*.js", "node_modules", "dist"]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws"],
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "env": {
      "dev": {
        "project": {
          "account": "",
          "profile": "weekly-report-dev",
          "region": "ap-northeast-2",
          "team": "lab",
          "service": "weekly-report",
          "owner": "jongwon"
        },
        "sshAllowedCidrs": [],
        "corsOrigins": ["http://localhost:3200", "http://localhost:3201"]
      }
    }
  }
}
