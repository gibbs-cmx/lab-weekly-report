{
  "name": "@wr/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node src/lambda/functions/api-server/localhost.ts",
    "build": "pnpm build:bundle",
    "build:bundle": "prisma generate && webpack --config webpack.config.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.cdk.json",
    "test": "vitest run",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "seed:local": "ts-node --transpile-only prisma/seed-dev.ts",
    "seed:admin": "ts-node --transpile-only prisma/seed-admin.ts",
    "tunnel:dev:rds": "../../scripts/tunnel-rds.sh dev",
    "db:dev:push": "STAGE=dev ts-node --transpile-only prisma/db-push.ts",
    "seed:dev": "STAGE=dev ts-node --transpile-only prisma/seed-dev.ts",
    "seed:dev:admin": "STAGE=dev ts-node --transpile-only prisma/seed-admin.ts",
    "cdk:synth": "cdk synth --context stage=dev --quiet",
    "cdk:diff:dev": "cdk diff --context stage=dev --profile weekly-report-dev",
    "deploy:dev:vpc": "cdk deploy weekly-report-dev-vpc --context stage=dev --profile weekly-report-dev",
    "deploy:dev:rds": "cdk deploy weekly-report-dev-rds --context stage=dev --profile weekly-report-dev",
    "deploy:dev:bastion": "cdk deploy weekly-report-dev-bastion --context stage=dev --profile weekly-report-dev",
    "deploy:dev:api": "pnpm build:bundle && cdk deploy weekly-report-dev-api --context stage=dev --profile weekly-report-dev"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1165.0",
    "@aws-sdk/credential-provider-ini": "^3.973.28",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.19.3",
    "@vendia/serverless-express": "^4.12.6",
    "@wr/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "aws-cdk": "^2.1148.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.2",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.3.1"
  }
}
